# Copy to .env.local. Defaults run immediately without external services.
DATA_MODE=demo
AI_PROVIDER=demo
NEXT_TELEMETRY_DISABLED=1

# Durable workspace, required when DATA_MODE=supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
WORKSPACE_ID=11111111-1111-4111-8111-111111111111
APP_PASSWORD=
SESSION_SECRET=
# Set to the public HTTPS origin behind a reverse proxy, e.g. https://signal.example.com
APP_ORIGIN=

# Optional live analyst, requires authenticated Supabase mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional n8n bearer credential, at least 32 characters.
WORKFLOW_TOKEN=
